#!/bin/sh
# A fast local shortcut, not a barrier: an uninstalled hook checks nothing, so the gate holds the
# dash rule over the whole tree and CI holds the OpenAPI document. Both are checked here first
# because a commit is cheaper to fix than a pushed branch.
set -e

em=$(printf '\342\200\224')  # U+2014 EM DASH
en=$(printf '\342\200\223')  # U+2013 EN DASH
if git diff --cached -U0 | grep '^+' | grep -qF -e "$em" -e "$en"; then
    echo "pre-commit: em-dash or en-dash in staged additions; use ':' or '-' (no-em-dash rule)." >&2
    exit 1
fi

exec ./scripts/generate-openapi.sh
