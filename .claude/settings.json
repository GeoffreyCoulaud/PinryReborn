{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(git stash:*)"
    ],
    "deny": ["AskUserQuestion", "EnterPlanMode"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/evidence-guard.py"
          }
        ]
      }
    ]
  }
}
